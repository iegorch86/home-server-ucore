# This file declares the additional software included in:
#
#   home-server-ucore
#   home-server-ucore-hci
#
# Most software is shared by both images.
# Entries explicitly marked HCI-only are installed only in
# home-server-ucore-hci.
#
# Fedora packages are updated through the normal Fedora/uCore
# package sources whenever the image is rebuilt.
#
# External projects are pinned to a release version and exact
# upstream commit. Renovate watches those versions and can open
# update PRs when new releases are published.


# ------------------------------------------------------------
# Native Fedora packages
# ------------------------------------------------------------

UCORE_EXTRA_PACKAGES="nut nut-client powertop btop fastfetch micro"


# ------------------------------------------------------------
# NetBird
# ------------------------------------------------------------
#
# NetBird requires special installation handling during image
# composition, so it is kept separate from the normal package list.

NETBIRD_PACKAGE="netbird"


# ------------------------------------------------------------
# UPSide
# ------------------------------------------------------------
#
# Cockpit frontend for Network UPS Tools.
# Renovate tracks the release and exact upstream commit.

UPSIDE_VERSION=1.0.6
UPSIDE_COMMIT=0761c8cc5aa566feec05d722c220ecd5f40bb9a3


# ------------------------------------------------------------
# Superfile
# ------------------------------------------------------------
#
# Terminal file manager.
# Renovate tracks the release and exact upstream commit.

SUPERFILE_VERSION=1.6.0
SUPERFILE_COMMIT=865dba26c1d8d35b95bd7b7501ebdeac66ce2618


# ------------------------------------------------------------
# VirtUI Manager - uCore HCI only
# ------------------------------------------------------------
#
# Terminal-based libvirt/QEMU virtual machine manager.
#
# VirtUI Manager is built as a local RPM and installed only in
# home-server-ucore-hci.
#
# Fedora 44 currently provides Textual 4.x while VirtUI Manager
# requires Textual >= 8.0.0. A compatible Textual release is
# therefore bundled privately with VirtUI Manager instead of
# replacing Fedora's system Python package.
#
# Renovate tracks the VirtUI Manager release and exact commit.

VIRTUI_MANAGER_VERSION=3.3.1
VIRTUI_MANAGER_COMMIT=4e3bc871504b1799db1ab89e6f1ff5b697f79f49

# Private Python dependency used only by VirtUI Manager.
VIRTUI_TEXTUAL_VERSION=8.2.8
